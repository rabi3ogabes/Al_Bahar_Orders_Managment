#--------------------------------------------------------------------------
# Al Bahar Home & Living — environment template
# Copy to .env and fill in values. NEVER commit real secrets.
#--------------------------------------------------------------------------
APP_NAME="Al Bahar Home & Living"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_BUSINESS_TIMEZONE=Asia/Qatar
APP_CURRENCY=QAR

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_SUPPORTED_LOCALES=en,ar

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=albahar
DB_USERNAME=albahar
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@albahar.qa"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (production media)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Auth / tokens
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
AUTH_REFRESH_TOKEN_TTL_DAYS=60
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Only honoured when APP_ENV=local or testing: returns the OTP in the API response for development.
OTP_DEV_ECHO=false
# Temporary until an SMS provider is connected: fixed login code shown on screen (ignored when SMS_DRIVER=http)
OTP_TEST_CODE=
STAFF_2FA_REQUIRED=true
PHONE_ALLOWED_COUNTRY_CODES=974

# SMS provider: null | twilio | unifonic (adapters in app/Domain/Notifications/Channels)
SMS_DRIVER=null
SMS_SENDER_ID=ALBAHAR

# Firebase Cloud Messaging (HTTP v1). Path to service-account JSON outside the repo.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# SADAD (Qatar) — values come from the merchant onboarding pack.
SADAD_ENABLED=false
SADAD_MODE=sandbox
SADAD_MERCHANT_ID=
SADAD_SECRET_KEY=
SADAD_WEBSITE=
SADAD_CHECKOUT_URL=
SADAD_STATUS_URL=
SADAD_REFUND_SUPPORTED=false

# Google Maps (customer app & admin pickers)
GOOGLE_MAPS_API_KEY=

# Reverb / WebSockets (live auctions)
REVERB_APP_ID=albahar
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
