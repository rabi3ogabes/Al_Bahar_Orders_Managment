<?xml version="1.0" encoding="utf-8"?>
<!--
    The one brand mark of the customer app's notifications (status bar and notification header): the Al Bahar sun over two
    waves, as a monochrome glyph. White only: the system uses the alpha channel and tints it with the brand colour
    (setColor / default_notification_color). The driver and staff apps have their own glyphs in their flavour folders.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Sun: circle r=3.5 at (12, 6.5). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.5,6.5a3.5,3.5 0 1,0 7,0a3.5,3.5 0 1,0 -7,0z" />
    <!-- Upper wave. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M3,13.5c1.5,-1.8 3,-1.8 4.5,0s3,1.8 4.5,0s3,-1.8 4.5,0s3,1.8 4.5,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.75" />
    <!-- Lower wave. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M3,19c1.5,-1.8 3,-1.8 4.5,0s3,1.8 4.5,0s3,-1.8 4.5,0s3,1.8 4.5,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.75" />
</vector>
